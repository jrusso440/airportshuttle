generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// NOTE: SQLite enums can be tricky across environments.
// For maximum compatibility, this schema uses STRING fields + app-level validation.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("DISPATCHER") // ADMIN | DISPATCHER | DRIVER
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  driverProfile Driver? @relation(fields: [driverId], references: [id])
  driverId      String? @unique
}

model Driver {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rides        Ride[]              @relation("RideDriver")
  availability DriverAvailability[]
  user         User?
}

model DriverAvailability {
  id        String   @id @default(cuid())
  driver    Driver   @relation(fields: [driverId], references: [id])
  driverId  String

  // 0=Sunday ... 6=Saturday
  dayOfWeek Int
  startMin  Int      // minutes from midnight (local)
  endMin    Int      // minutes from midnight (local)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId, dayOfWeek])
}

model Vehicle {
  id        String   @id @default(cuid())
  label     String   // e.g., "Van 1"
  plate     String?
  capacity  Int      @default(6)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rides Ride[] @relation("RideVehicle")
}

model RecurringRide {
  id              String   @id @default(cuid())
  freq            String   @default("WEEKLY") // WEEKLY

  // Weekly pattern: list of weekdays as CSV string, e.g., "1,3,5"
  daysOfWeekCsv   String

  pickupHour      Int
  pickupMinute    Int

  pickupLocation  String
  dropoffLocation String
  airport         String?
  flightNumber    String?
  passengerName   String
  passengerPhone  String?
  passengerEmail  String?
  partySize       Int      @default(1)
  luggageCount    Int      @default(0)
  estimatedPriceCents Int @default(0)
  rideType        String   @default("OTHER") // TO_AIRPORT | FROM_AIRPORT | OTHER
  specialNotes    String?

  startDate       DateTime // date-only (midnight)
  endDate         DateTime?

  defaultDriverId  String?
  defaultVehicleId String?

  active          Boolean  @default(true)

  occurrences Ride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
}

model Ride {
  id              String   @id @default(cuid())
  date            DateTime // date of pickup (normalized at midnight local in UI)
  pickupTime      DateTime // full datetime for sorting/printing
  pickupLocation  String
  dropoffLocation String
  airport         String?
  flightNumber    String?
  flightTime      DateTime?
  passengerName   String
  passengerPhone  String?
  passengerEmail  String?
  partySize       Int      @default(1)
  luggageCount    Int      @default(0)
  estimatedPriceCents Int @default(0)
  rideType        String   @default("OTHER") // TO_AIRPORT | FROM_AIRPORT | OTHER
  specialNotes    String?
  status          String   @default("REQUESTED") // REQUESTED | SCHEDULED | ASSIGNED | COMPLETED | CANCELED | NOSHOW

  assignedDriver   Driver?  @relation("RideDriver", fields: [assignedDriverId], references: [id])
  assignedDriverId String?
  assignedVehicle  Vehicle? @relation("RideVehicle", fields: [assignedVehicleId], references: [id])
  assignedVehicleId String?

  recurringRide   RecurringRide? @relation(fields: [recurringRideId], references: [id])
  recurringRideId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([pickupTime])
  @@index([assignedDriverId])
  @@index([recurringRideId])
}
